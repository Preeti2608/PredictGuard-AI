# PredictGuard AI — Environment Configuration Example

# Server Environment
APP_NAME=PredictGuard AI
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins. Defaults to empty list (same-origin only).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREDICT=60/minute

# Model Paths
IMAGE_MODEL_PATH=models/casting_defect_classifier.h5
SENSOR_MODEL_PATH=models/decision_tree.joblib
REGRESSION_MODEL_PATH=models/tool_wear_regressor.joblib
MODEL_METADATA_PATH=models/model_metadata.json

# Image Processing Limits
MAX_IMAGE_SIZE_BYTES=5242880
MAX_IMAGE_PIXELS=10000000
IMAGE_INTERPOLATION=nearest

# Risk Thresholds
IMAGE_DEFECT_MEDIUM_THRESHOLD=0.30
IMAGE_DEFECT_HIGH_THRESHOLD=0.70
SENSOR_FAILURE_MEDIUM_THRESHOLD=0.30
SENSOR_FAILURE_HIGH_THRESHOLD=0.70

# AI4I Physical Sensor Validation Bounds
AIR_TEMP_MIN=280.0
AIR_TEMP_MAX=320.0
PROCESS_TEMP_MIN=295.0
PROCESS_TEMP_MAX=330.0
ROTATIONAL_SPEED_MIN=1000.0
ROTATIONAL_SPEED_MAX=3000.0
TORQUE_MIN=0.0
TORQUE_MAX=100.0
TOOL_WEAR_MIN=0.0
TOOL_WEAR_MAX=300.0
